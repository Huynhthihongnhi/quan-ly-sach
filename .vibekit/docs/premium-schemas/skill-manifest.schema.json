{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVCK Premium source catalog v3",
  "type": "object",
  "required": ["version", "kitVersion", "surfaces", "skills"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 3},
    "kitVersion": {"type": "string"},
    "description": {"type": "string"},
    "surfaces": {"type": "object", "additionalProperties": {"type": "string"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["name", "version", "description", "license", "access", "compatibility", "dependencies", "conflicts", "capabilities", "surfaces"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "license": {"type": "string"},
        "access": {"type": "object", "required": ["tier"], "properties": {"tier": {"enum": ["community", "premium"]}, "feature": {"type": "string"}}, "additionalProperties": false},
        "compatibility": {"type": "object", "required": ["kit", "node"], "properties": {"kit": {"type": "string"}, "node": {"type": "string"}}, "additionalProperties": false},
        "dependencies": {"type": "array", "items": {"type": "object", "required": ["id", "range"], "properties": {"id": {"type": "string"}, "range": {"type": "string"}}, "additionalProperties": false}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"enum": ["repo.read", "repo.write.scoped", "shell.validate", "user.interview", "web.official-docs", "git.read", "git.worktree", "task.evidence"]}},
        "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["claude", "cursor", "codex", "opencode", "grok", "kimi", "copilot"]}}
      }
    }
  }
}
