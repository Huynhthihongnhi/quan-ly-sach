{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVCK Premium task brief",
  "type": "object",
  "required": ["goal", "scope", "criteria"],
  "additionalProperties": false,
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "risk": {"enum": ["low", "medium", "high"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonGoals": {"type": "array", "items": {"type": "string"}},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "description", "requires"], "additionalProperties": false, "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["static", "unit", "contract", "integration", "e2e", "visual", "manual"]}}}}},
    "budget": {"type": "object", "required": ["maxIterations", "maxMinutes"], "additionalProperties": false, "properties": {"maxIterations": {"type": "integer", "minimum": 1}, "maxMinutes": {"type": "integer", "minimum": 1}}},
    "questions": {"type": "array", "items": {"type": "object"}},
    "assumptions": {"type": "array", "items": {"type": "object"}},
    "claims": {"type": "array", "items": {"type": "object"}}
  }
}
