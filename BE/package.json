{
  "name": "quan-ly-sach-be",
  "version": "0.0.1",
  "private": true,
  "description": "Backend API and worker for Quan-Ly-Sach library system",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:worker",
    "build:api": "nest build",
    "build:worker": "nest build --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --watch --config nest-cli.worker.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "npm run test:unit",
    "test:unit": "jest --config test/jest.config.js",
    "test:watch": "jest --config test/jest.config.js --watch",
    "test:integration": "jest --config test/jest.integration.config.js --runInBand",
    "test:contract": "jest --config test/jest.contract.config.js --runInBand",
    "test:concurrency": "CONCURRENCY_TESTS=1 jest --config test/jest.concurrency.config.js --runInBand",
    "test:acceptance": "ACCEPTANCE_TESTS=1 jest --config test/jest.acceptance.config.js --runInBand",
    "test:acceptance:countercheck": "IAM_GUARD_COUNTERCHECK=1 jest --config test/jest.acceptance.config.js --runInBand --testPathPatterns=iam-guard-countercheck",
    "test:security": "SECURITY_TESTS=1 jest --config test/jest.security.config.js --runInBand",
    "test:performance": "PERFORMANCE_TESTS=1 jest --config test/jest.performance.config.js --runInBand",
    "validate": "npm run lint && npm run typecheck && npm run test:unit && npm run test:contract && npm run build",
    "db:status": "npm run build && node dist/tools/db-cli.js status",
    "db:preview": "npm run build && node dist/tools/db-cli.js preview",
    "db:up": "npm run build && node dist/tools/db-cli.js up",
    "db:down": "npm run build && node dist/tools/db-cli.js down",
    "bootstrap:admin": "npm run build && node dist/tools/bootstrap-cli.js",
    "openapi:export": "npm run build && node dist/openapi-export.js",
    "docker:up": "docker compose -f docker/compose.local.yml --env-file docker/.env.docker up -d --wait",
    "docker:down": "docker compose -f docker/compose.local.yml --env-file docker/.env.docker down",
    "docker:down:clean": "docker compose -f docker/compose.local.yml --env-file docker/.env.docker down -v",
    "docker:ps": "docker compose -f docker/compose.local.yml --env-file docker/.env.docker ps",
    "docker:logs": "docker compose -f docker/compose.local.yml --env-file docker/.env.docker logs -f"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "mysql2": "3.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.25"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.3.0",
    "jest": "30.0.5",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  }
}
