PORT=3000
NODE_ENV=development

# Align with BE/docker/.env.docker (local-app-change-me by default)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=app
DATABASE_PASSWORD=local-app-change-me
DATABASE_NAME=quan_ly_sach_dev
DATABASE_TEST_NAME=quan_ly_sach_test

# Migration runner credentials (separate from runtime app user)
DATABASE_MIGRATION_USERNAME=migration
DATABASE_MIGRATION_PASSWORD=local-migration-change-me
DATABASE_MIGRATION_NAME=quan_ly_sach_dev
MIGRATIONS_DIR=migrations

# One-time bootstrap (operator CLI only, not HTTP)
BOOTSTRAP_ADMIN_EMAIL=admin@local.test
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator

# Session and CSRF (D03)
SESSION_COOKIE_NAME=library-session
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=43200000
CSRF_HMAC_SECRET=local-dev-csrf-secret-change-me
RATE_LIMIT_HMAC_SECRET=local-dev-rate-limit-secret-change-me
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081,https://*.trycloudflare.com
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Mail sandbox (Mailpit via docker compose)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@local.test

# Outbox encryption and worker jobs (S2-01)
OUTBOX_ENCRYPTION_KEY_ID=local-v1
OUTBOX_ENCRYPTION_KEY=
JOB_BATCH_SIZE=10
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=5
JOB_POLL_SECONDS=5

# Public app origin for email links (never taken from Host header)
APP_PUBLIC_ORIGIN=http://127.0.0.1:5174/cms
RESET_PASSWORD_TTL_MS=900000
ACTIVATION_TTL_MS=86400000
FORGOT_RATE_LIMIT_MAX=5
FORGOT_RATE_LIMIT_WINDOW_MS=900000
