# Production environment template for S7-02 (Ubuntu 24.04 LTS, intranet/VPN only per D10).
# Copy to `env.production` in the same directory (gitignored, never commit real values), fill
# in every REQUIRED line, and reference it from compose.prod.yml via `env_file:`. Do not put
# real secrets in this .example file, in compose.prod.yml, or bake them into the Docker image.
#
# Generate a fresh 32-byte key or secret with, for example:
#   openssl rand -base64 32

# --- App ---
NODE_ENV=production
PORT=3000
# Public HTTPS origin behind the intranet reverse proxy; used to build reset/activation links.
APP_PUBLIC_ORIGIN=https://library.internal.example
# Comma-separated list of origins the CSRF/mutation-origin guard accepts for browser requests.
ALLOWED_ORIGINS=https://library.internal.example
# compose.prod.yml puts exactly one nginx hop in front of api (api itself publishes no port),
# so req.ip can safely trust the first X-Forwarded-For hop. Remove this if api is ever reached
# without that proxy in front of it.
TRUST_PROXY=1

# --- Database (runtime app/worker user: DML only, not the migration account) ---
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=quan_ly_sach
# Read by the mysql container's own entrypoint to create the initial database on first boot.
# Must stay identical to DATABASE_NAME and DATABASE_MIGRATION_NAME below: compose.prod.yml
# applies this same env file to mysql/api/worker alike, so a mismatch here silently points the
# app at a database MySQL never created.
MYSQL_DATABASE=quan_ly_sach
DATABASE_USERNAME=REQUIRED_set_a_dedicated_app_user
DATABASE_PASSWORD=REQUIRED_set_a_strong_password
# compose.prod.yml applies this same env file to mysql, api, and worker alike (documented
# over-sharing, see planning/evidence/S7-02.md); splitting per-service env files is deferred.
MYSQL_ROOT_PASSWORD=REQUIRED_generate_with_openssl_rand

# --- Session and CSRF (D03) ---
SESSION_COOKIE_NAME=library-session
SESSION_IDLE_TTL_MS=1800000
SESSION_ABSOLUTE_TTL_MS=43200000
# REQUIRED in production: BE/src/config/require-production-secret.ts refuses to boot with the
# built-in development fallback once NODE_ENV=production.
CSRF_HMAC_SECRET=REQUIRED_generate_with_openssl_rand
RATE_LIMIT_HMAC_SECRET=REQUIRED_generate_with_openssl_rand

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FORGOT_RATE_LIMIT_MAX=5
FORGOT_RATE_LIMIT_WINDOW_MS=900000

# --- Challenges (reset/activation, D04) ---
RESET_PASSWORD_TTL_MS=900000
ACTIVATION_TTL_MS=86400000

# --- Mail (production SMTP provider: D04 leaves this open, fill in when chosen) ---
MAIL_HOST=REQUIRED_set_production_smtp_host
MAIL_PORT=587
MAIL_USER=REQUIRED_set_smtp_username
MAIL_PASSWORD=REQUIRED_set_smtp_password
MAIL_FROM=noreply@library.internal.example

# --- Outbox encryption (payload contains raw reset/activation tokens at rest) ---
OUTBOX_ENCRYPTION_KEY_ID=prod-v1
# REQUIRED in production, must decode to exactly 32 bytes: openssl rand -base64 32
OUTBOX_ENCRYPTION_KEY=REQUIRED_generate_with_openssl_rand
JOB_BATCH_SIZE=10
JOB_LEASE_SECONDS=30
JOB_MAX_ATTEMPTS=5
JOB_POLL_SECONDS=1

# --- Business rules (D07 draft targets) ---
CIRCULATION_ENABLED=1
MAX_ACTIVE_LOANS=5
RESERVATION_TTL_SECONDS=86400
LOAN_REAUTH_MAX_FAILURES=3
LOAN_REAUTH_WINDOW_MS=900000
LOAN_TRANSITION_DEADLOCK_RETRIES=3

# --- Digital assets (persistent storage, must be a mounted volume, see compose.prod.yml) ---
DIGITAL_STORAGE_ROOT=/app/storage/digital-assets

# --- Do NOT set in production ---
# CONTRACT_TEST_ACTOR bypasses CSRF, origin checks, and authentication; BE/src/config/app-config.service.ts
# refuses to boot if this is "1" while NODE_ENV is not "test". Leave it unset here.

# --- Migration runner only (separate DDL-capable account; never used by api/worker at runtime) ---
# Invoke as a one-off `docker compose run` step, not a long-running service.
DATABASE_MIGRATION_HOST=mysql
DATABASE_MIGRATION_PORT=3306
DATABASE_MIGRATION_NAME=quan_ly_sach
DATABASE_MIGRATION_USERNAME=REQUIRED_set_a_dedicated_migration_user
DATABASE_MIGRATION_PASSWORD=REQUIRED_set_a_strong_password

# --- One-time admin bootstrap (run once via the bootstrap CLI, then remove from the environment) ---
BOOTSTRAP_ADMIN_EMAIL=REQUIRED_set_before_first_boot
BOOTSTRAP_ADMIN_PASSWORD=REQUIRED_generate_a_strong_password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
